# Copie este arquivo para docker/.env e preencha se desejar.
# TUDO E OPCIONAL: a imagem funciona sem .env (acesso publico ao Hugging Face).

# Token do Hugging Face. Sem ele funciona, mas o HF avisa sobre rate limit;
# com token os downloads de modelo/dataset sao mais rapidos e sem limite.
HF_TOKEN=

# Token opcional para proteger o Jupyter Lab. Vazio = sem token
# (adequado quando o acesso e feito por tunel SSH).
JUPYTER_TOKEN=
